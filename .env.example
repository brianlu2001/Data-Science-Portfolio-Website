# Production variables. Do not copy real secrets into this file.
DATABASE_URL=postgresql://username:password@host/database?sslmode=require
# Generate a random secret of at least 32 characters.
SESSION_SECRET=
# Use a unique administrator password of at least 14 characters.
ADMIN_PASSWORD=
# Additional trusted origins, comma separated. Canonical site and Vercel URLs are handled automatically.
APP_ORIGINS=
NODE_ENV=production
# Optional features:
BLOB_READ_WRITE_TOKEN=
OPENAI_API_KEY=
# npm run dev uses its own isolated database and .local/credentials.json instead.
