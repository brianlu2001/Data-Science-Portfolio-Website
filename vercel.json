{
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/public",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "build": {
    "env": {
      "NODE_ENV": "development"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}